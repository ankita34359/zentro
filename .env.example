# Local development only. On Embarko, PORT / DATA_DIR / APP_NAME / APP_VERSION / CRON_SECRET are set by the platform.
PORT=3001
DATA_DIR=./data
CRON_SECRET=local-dev-secret-change-me

# Required by the server (without them it runs in "holding mode": site shows a setup notice, /api answers 503).
# On Embarko you type these on the app's App setup page, never in a file or in chat.
# Locally, put your own random values here in an untracked .env. Each must be at least 32 characters, and different.
# SESSION_SECRET=
# ENCRYPTION_KEY=

# Registration (who may create an account). Closed unless BOTH are set; a missing or wrong value never stops the server.
# On Embarko the owner sets these through the app's environment variables; never commit a real code.
# REGISTRATION_MODE=code
# REGISTRATION_CODE=        # at least 8 characters

# Optional
# APP_URL=https://zentro.embarko.app
# LOG_LEVEL=info        # debug | info | warn | error
# TRUST_PROXY=1
# ZENTRO_STRICT_TENANT=1   # extra tenant checks in the data layer (always on under the test runner)
