{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "types": ["node"],
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": "..",
    "paths": { "@/*": ["frontend/src/*"] }
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../backend/src/**/*.ts", "../frontend/src/**/*.ts", "../frontend/src/**/*.tsx", "../frontend/src/vite-env.d.ts"]
}
