{
  "name": "zentro",
  "version": "0.1.2",
  "private": true,
  "description": "Zentro: AI-powered performance management and intelligence platform (stage 1.2 backend foundation)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/check-node20.mjs && tsc -p backend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "start": "node build/backend/src/server.js",
    "dev:server": "tsx watch backend/src/server.ts",
    "dev:client": "vite --config frontend/vite.config.ts",
    "test": "vitest run",
    "check:node20": "node scripts/check-node20.mjs",
    "typecheck": "tsc -p backend/tsconfig.json --noEmit && tsc -p tests/tsconfig.json"
  },
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "better-sqlite3": "^12.11.1",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "vitest": "^4.1.12"
  }
}
