{
  "name": "zentro",
  "version": "0.1.3",
  "private": true,
  "description": "Zentro: AI-powered performance management and intelligence platform (stage 1.3 frontend foundation)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/check-node20.mjs && tsc -p backend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "start": "node build/backend/src/server.js",
    "dev:server": "tsx watch backend/src/server.ts",
    "dev:client": "vite --config frontend/vite.config.ts",
    "test": "vitest run",
    "check:node20": "node scripts/check-node20.mjs",
    "typecheck": "tsc -p backend/tsconfig.json --noEmit && tsc -p frontend/tsconfig.json && tsc -p tests/tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/compression": "^1.8.1",
    "@types/supertest": "^6.0.3",
    "jsdom": "^28.1.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "vitest": "^4.1.12"
  }
}
